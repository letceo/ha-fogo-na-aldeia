:: 31 {"position":"800,1325","size":"100,100"}
<<nobr>>
<<silently>>
<<set $k1 to false>>
<<set $k2 to false>>
<<set $k3 to false>>
<<set $k4 to false>>
<<set $k5 to false>>
<<set $k6 to false>>
<<set $k7 to false>>
<<set $k8 to false>>
<<set $k9 to false>>
<<set $k10 to false>>
<<set $d1 to false>>
<<set $d2 to false>>
<</silently>>

<div class="scene">
    <div class="image-bg casa fullheight"></div>
    <div class="image-fumo casafumo1 fumo-leve fullheight"></div>
    <div class="image-fumo casafumo2 fumo-medio fullheight"></div>
    <div class="image-fumo casafumo3 fumo-entra-3 fullheight"></div>
    <div class="image-fumo casafumo4 fumo-entra-4 fullheight"></div>
    <div class="image-fumo casafumo5 fumo-entra-5 fullheight"></div>
    <div class="image-bg casa-semjanela fullheight"></div>

    <div class="fumo-casa nv2"><i></i><i></i><i></i><i></i><i></i><i></i></div>

    <div class="notebook-overlay">
        <div class="notebook" role="group" aria-labelledby="nb-titulo-kit">
            <h2 class="notebook-title" id="nb-titulo-kit">Kit de Emergência</h2>
            <div class="notebook-list">
                <label class="nb-row"><<checkbox "$k1" false true>> Documentos de identificação e papéis importantes</label>
                <label class="nb-row"><<checkbox "$k2" false true>> Kit de primeiros socorros e medicamentos</label>
                <label class="nb-row"><<checkbox "$k3" false true>> Rádio sem pilhas</label>
                <label class="nb-row"><<checkbox "$d1" false true>> Comida perecível, como iogurtes e queijos frescos</label>
                <label class="nb-row"><<checkbox "$k4" false true>> Água engarrafada e alimentos não perecíveis</label>
                <label class="nb-row"><<checkbox "$k5" false true>> Muda de roupa e artigos de higiene</label>
                <label class="nb-row"><<checkbox "$k6" false true>> Lanterna, apito, rádio</label>
                <label class="nb-row"><<checkbox "$d2" false true>> Jogos de tabuleiro e livros para entretenimento</label>
                <label class="nb-row"><<checkbox "$k7" false true>> Carregador de telemóvel e dinheiro</label>
                <label class="nb-row"><<checkbox "$k8" false true>> Lista de contactos de família e amigos</label>
                <label class="nb-row"><<checkbox "$k9" false true>> Bens valiosos (computador, álbuns de fotografias)</label>
                <label class="nb-row"><<checkbox "$k10" false true>> Extintor de incêndio</label>
            </div>
            <div class="choices notebook-actions">
                <<button "Confirmar kit" "Resultado Kit">>
                    <<set $fezKit to true>>
                    <<set $kitPerfeito to false>>
                    <<set $kit to false>>
                    <<set $corretasKit to 0>>
                    <<if $k1>> <<set $corretasKit to $corretasKit + 1>> <</if>>
                    <<if $k2>> <<set $corretasKit to $corretasKit + 1>> <</if>>
                    <<if $k4>> <<set $corretasKit to $corretasKit + 1>> <</if>>
                    <<if $k5>> <<set $corretasKit to $corretasKit + 1>> <</if>>
                    <<if $k6>> <<set $corretasKit to $corretasKit + 1>> <</if>>
                    <<if $k7>> <<set $corretasKit to $corretasKit + 1>> <</if>>
                    <<if $k8>> <<set $corretasKit to $corretasKit + 1>> <</if>>
                    <<set $erradasKit to 0>>
                    <<if $k3>> <<set $erradasKit to $erradasKit + 1>> <</if>>
                    <<if $k9>> <<set $erradasKit to $erradasKit + 1>> <</if>>
                    <<if $k10>> <<set $erradasKit to $erradasKit + 1>> <</if>>
                    <<if $d1>> <<set $erradasKit to $erradasKit + 1>> <</if>>
                    <<if $d2>> <<set $erradasKit to $erradasKit + 1>> <</if>>
                    <<if $corretasKit eq 7 and $erradasKit eq 0>>
                        <<set $kit to true>>
                        <<set $kitPerfeito to true>>
                        <<set $mensagemKit to "Excelente! Preparaste o kit perfeitamente. Levas tudo o que é essencial para enfrentar a emergência.">>
                        <<run mostrarToast('achievement', 'Kit Perfeito\nMontaste o kit de emergência ideal sem erros!', 'backpack')>>
                    <<elseif ($corretasKit eq 6 and $erradasKit eq 0) or ($corretasKit eq 7 and $erradasKit eq 1) or ($corretasKit eq 6 and $erradasKit eq 1)>>
                        <<set $kit to true>>
                        <<set $mensagemKit to "Quase lá! Faltou algum item essencial ou levaste algo desnecessário. Revê a tua mochila e corrige antes de partires.">>
                    <<else>>
                        <<set $kit to false>>
                        <<set $mensagemKit to "O kit não está completo ou levas muitas coisas desnecessárias. Vais ter dificuldades durante a evacuação.">>
                    <</if>>
                <</button>>
            </div>
        </div>
    </div>

    <div class="text-box fira-sans-regular">
        <div class="ui-btn">[[⟲]] <<back "←">></div>
        <<if $mobilidadeReduzida>>
            <p class="animar nb-dica">Enquanto isso, penso no que preciso de levar para não ser apanhada desprevenida quando chegar a hora de sair. Marco no caderno o que devo lá pôr.</p>
        <<else>>
            <p class="animar nb-dica">Lembro-me que é importante ter um kit, para não ser apanhada desprevenida. Marco no caderno o que devo lá pôr.</p>
        <</if>>
        <p class="animar"><b>O que devo levar no kit?</b></p>
    </div>
</div>
<</nobr>>


