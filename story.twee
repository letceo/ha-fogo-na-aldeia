:: Widget [widget] {"position":"0,1200","size":"100,100"}
<<widget "resumoEscolhas">><<nobr>>
<<set _opcoes = _args[0]>>
<<set _acertos = _opcoes.filter(function(o){ return o[1] && o[2]; })>>
<<set _erros   = _opcoes.filter(function(o){ return o[1] && !o[2]; })>>
<<set _faltou  = _opcoes.filter(function(o){ return !o[1] && o[2]; })>>
<<set _total   = _opcoes.filter(function(o){ return o[2]; }).length>>
<<set _perfeito = (_acertos.length === _total && _erros.length === 0)>>

<div class="er-card">

  <div class="er-head">
    <div class="er-score">
      <span class="er-score-num"><<= _acertos.length>></span><span class="er-score-slash">/</span><span class="er-score-total"><<= _total>></span>
      <span class="er-score-label">corretas</span>
    </div>
    <div class="er-bar">
      <<for _o range _opcoes>><<if _o[2]>><<if _o[1]>><span class="er-seg er-seg-ok"></span><<else>><span class="er-seg er-seg-miss"></span><</if>><</if>><</for>>
    </div>
  </div>

  <<if _perfeito>>
    <p class="er-msg-ok">🌟 Escolha perfeita!</p>
  <<else>>

    <<if _erros.length>>
      <div class="er-group">
        <div class="er-group-title er-t-bad">❌ Não devias ter escolhido <span class="er-count"><<= _erros.length>></span></div>
        <div class="er-chips"><<for _e range _erros>><span class="er-chip er-chip-bad"><i>✕</i><<= _e[0]>></span><</for>></div>
      </div>
    <</if>>

    <<if _faltou.length>>
      <div class="er-group">
        <div class="er-group-title er-t-miss">⚠️ Faltou escolher <span class="er-count"><<= _faltou.length>></span></div>
        <div class="er-chips"><<for _f range _faltou>><span class="er-chip er-chip-miss"><i>!</i><<= _f[0]>></span><</for>></div>
      </div>
    <</if>>

    <<if _acertos.length>>
      <div class="er-group">
        <div class="er-group-title er-t-ok">✅ Acertaste <span class="er-count"><<= _acertos.length>></span></div>
        <div class="er-chips"><<for _a range _acertos>><span class="er-chip er-chip-ok"><i>✓</i><<= _a[0]>></span><</for>></div>
      </div>
    <</if>>

  <</if>>
</div>
<</nobr>><</widget>>

<<widget "peFundo">><<nobr>>
    <<if pontoEncontroPreparado()>>
        <div class="image-bg pontoencontro"></div>
    <<else>>
    	<div class="image-bg ponto-de-encontro"></div>
    <</if>>
<</nobr>><</widget>>

<<widget "peFrente">><<nobr>>
	<<if pontoEncontroPreparado()>>
    	<div class="image-bg pontodeencontro-semceu"></div>
    <<else>>
    	<div class="image-bg ponto-de-encontrosemfundo"></div>
    <</if>>
<</nobr>><</widget>>


