/* Passagem 19: senhora + Bobi por cima da multidão.
   A altura é só a área acima da text-box (--ev-textbox-px, medida pelo JS),
   com a imagem encostada ao fundo dessa área: o Bobi nunca fica tapado. */
.image-overlay.evacuar {
  background-image: url("https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/evacuar.png");
  background-size: contain;
  background-position: center bottom;
  background-repeat: no-repeat;

  top: 0 !important;
  height: calc(var(--app-height) - var(--ev-textbox-px, 34vh) + var(--ev-desce, 5vh)) !important;
}

.rio {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/rio.webp);
}

.floresta {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/floresta.webp);
}

.kit {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/kit2.webp);
}

.kit1 {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/kit1.png);
}

.fumo-sino-bg {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/fumo-sino-bg.webp);
}

.fogo-na-casa {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/fogo-na-casa.webp);
}

.fogo-na-casa-overlay {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/fogo-na-casa-overlay.png);
}

.mobilidade {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/mobilidade.jpg);
}

.salva-pelo-bombeiro {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/salva-pelo-bombeiro.jpg);
}

.ponto-da-mulher {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/ponto-da-mulher.png);
}

.ponto-de-encontro-fogo {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/ponto-de-encontro-fogo.webp);
  animation:
    sceneFade .5s ease,
    vibrate-2 0.35s linear infinite both,
    fogo-aparece-flicker 2.8s ease-in-out infinite;
}

.ponto-de-encontrosemfundo {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/ponto-de-encontrosemfundo.webp);
}

.pontodeencontro-fuminho {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/pontodeencontro-fuminho.webp);
}

.pontodeencontro-fumonomonte {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/pontodeencontro-fumonomonte.png);
}

.pontodeencontro-semceu {
  background-image: url(https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/pontodeencontro-semceu.webp);
}

.overlay-top {
  z-index: 3 !important;
  height: 100vh !important;
}

/* ---- Casa a arder: transição "de pé" → "ardida" ---- */
.casafire-de {
  z-index: 2;
  background-image: url("https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/casa.webp");
  animation: fadeOut-de 3s ease-in-out forwards;
}

.casafire-para {
  z-index: 1;
  background-image: url("https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/casa-fire.jpg");
}

@keyframes fadeOut-de {
  0% {
    opacity: 1;
  }

  100% {
    opacity: 0;
  }
}

/* ---- Casa ardida: cover + pan vertical (personagem → telhado) ---- */
.image-bg.casa-ardida,
.image-bg.casa-ardida.fullheight {
  background-image: url("https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/casa-ardida.jpg");
  background-size: cover;
  background-position: center 100%;
  background-repeat: no-repeat;
  background-color: #1a1108;

  top: 0 !important;
  bottom: auto !important;
  height: calc(var(--app-height) - var(--ca-textbox-px, 28vh)) !important;
  min-height: 0 !important;

 animation:
    sceneFade .5s ease,
    casa-ardida-pan 14s ease-in-out .8s forwards;
}

@keyframes casa-ardida-pan {
  0%   { background-position: center 100%; }  /* começa na personagem */
  60%  { background-position: center 40%;  }  /* sobe devagar (menos que antes) */
  72%  { background-position: center 40%;  }  /* pausa breve no topo */
  100% { background-position: center 85%;  }  /* desce mais depressa e centra a senhora */
}

/* Retrato: a área já é quase do formato da imagem, sem pan */
@media screen and (orientation: portrait) {
  .image-bg.casa-ardida,
  .image-bg.casa-ardida.fullheight {
    background-position: 56% bottom;
    animation: sceneFade .5s ease;
  }
}

/* final-2: casa não ardida — pan de baixo (senhora) → topo (casa) → senhora.
   Fundo e overlay partilham tamanho e animação, para ficarem alinhados. */
.image-bg.casa-naoardida-final.pan-final,
.image-overlay.casa-naoardida-finallady.pan-final {
  background-size: cover;
  background-position: center 100%;
  background-repeat: no-repeat;

  top: 0 !important;
  bottom: auto !important;
  height: calc(var(--app-height) - var(--ca-textbox-px, 28vh)) !important;
  min-height: 0 !important;

  animation:
    sceneFade .5s ease,
    casa-final-pan 14s ease-in-out .8s forwards;
}

@keyframes casa-final-pan {
  0%   { background-position: center 100%; }  /* começa na senhora */
  60%  { background-position: center 35%;  }  /* sobe devagar até à casa/telhado */
  72%  { background-position: center 35%;  }  /* pausa breve no topo */
  100% { background-position: center 100%; }  /* desce e fica na senhora a olhar para a casa */
}

/* Retrato: a imagem já cabe quase toda, sem pan */
@media screen and (orientation: portrait) {
  .image-bg.casa-naoardida-final.pan-final,
  .image-overlay.casa-naoardida-finallady.pan-final {
    background-position: 85% bottom;
    animation: sceneFade .5s ease;
  }
}

.salvar-laurinda {
  background-image: url("https://cdn.jsdelivr.net/gh/letceo/ha-fogo-na-aldeia@main/images/cenas/salvar-laurinda.jpg");
}

